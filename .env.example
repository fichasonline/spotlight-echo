# ─────────────────────────────────────────────────────────────
# Copiá este archivo a `.env` y completá los valores.
# `.env` está en .gitignore: nunca se commitea.
# ─────────────────────────────────────────────────────────────

# Supabase — proyecto y credenciales públicas (expuestas al browser)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase — uso server-side (funciones de /api)
SUPABASE_URL=

# Token que autentica al servicio externo que publica contra /api/publish
PUBLISHER_TOKEN=

# Meta / Instagram — publicación automática de historias
META_API=
META_IG_USER_ID=
